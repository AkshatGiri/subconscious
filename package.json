{
  "name": "subconscious",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun --hot index.ts serve",
    "start": "bun run index.ts serve",
    "status": "bun run index.ts status",
    "demo": "bun run src/examples/demo.ts",
    "diagrams:build": "bun run scripts/build-diagrams.ts",
    "diagrams:serve": "bun run scripts/serve-diagrams.ts",
    "diagrams": "bun run diagrams:build && bun run diagrams:serve",
    "typecheck": "bunx tsc --noEmit",
    "test": "bun test",
    "session:export": "bun run scripts/export-session.ts"
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^5"
  }
}
