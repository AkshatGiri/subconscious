# Storage
MEMORY_DB_PATH=./data/memory.db
MEMORY_LOG_LEVEL=warn

# Engine tuning
MEMORY_SHORT_TERM_BUFFER_SIZE=20
MEMORY_SHORT_TERM_SUMMARY_MESSAGES=12
MEMORY_WORKING_SIZE=7
MEMORY_EMBEDDING_DIMS=192
MEMORY_DECAY_HALF_LIFE_HOURS=336
MEMORY_DECAY_CURVE_SHAPE=1.35
MEMORY_DECAY_AUTO_ARCHIVE=false
MEMORY_MIN_STRENGTH=0.05
MEMORY_ARCHIVE_THRESHOLD=0.08
MEMORY_RECALL_REFRESH_BASE_BOOST=0.14
MEMORY_RECALL_REFRESH_MAX_BOOST=0.42
MEMORY_RECALL_REFRESH_WINDOW_HOURS=720
MEMORY_CONSOLIDATE_INTERVAL_MS=60000
MEMORY_DECAY_INTERVAL_MS=120000
MEMORY_QUEUE_POLL_MS=2000
MEMORY_CANDIDATE_POOL_SIZE=64
MEMORY_GRAPH_EXPANSION_DEPTH=2

# Optional subconscious LLM
MEMORY_LLM_ENABLED=false
MEMORY_LLM_PROVIDER=openai_compatible
MEMORY_LLM_ENDPOINT=https://api.openai.com/v1/chat/completions
MEMORY_LLM_API_KEY=
MEMORY_LLM_MODEL=gpt-4.1-mini
MEMORY_LLM_TEMPERATURE=0.1

# Pi extension bridge envs (set when running `pi -e ./extensions/pi-subconscious.js`)
# SUBCONSCIOUS_API_URL=http://127.0.0.1:8787
# SUBCONSCIOUS_EXT_LOG_LEVEL=info
# SUBCONSCIOUS_INJECT_MODE=message
# SUBCONSCIOUS_MESSAGE_DISPLAY=false
# SUBCONSCIOUS_TOOL_SET=minimal
# SUBCONSCIOUS_RECALL_DETAIL=summary
# SUBCONSCIOUS_EXT_TRACE_IO=false
# SUBCONSCIOUS_EXT_TRACE_MAX_CHARS=6000
# SUBCONSCIOUS_EXT_TRACE_MAX_ARRAY_ITEMS=20
# SUBCONSCIOUS_EXT_TRACE_MAX_OBJECT_KEYS=30
