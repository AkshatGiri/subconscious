# Storage
MEMORY_DB_PATH=./data/memory.db

# Engine tuning
MEMORY_SHORT_TERM_BUFFER_SIZE=20
MEMORY_SHORT_TERM_SUMMARY_MESSAGES=12
MEMORY_WORKING_SIZE=7
MEMORY_EMBEDDING_DIMS=192
MEMORY_DECAY_HALF_LIFE_HOURS=48
MEMORY_MIN_STRENGTH=0.05
MEMORY_ARCHIVE_THRESHOLD=0.08
MEMORY_CONSOLIDATE_INTERVAL_MS=60000
MEMORY_DECAY_INTERVAL_MS=120000
MEMORY_QUEUE_POLL_MS=2000
MEMORY_CANDIDATE_POOL_SIZE=64
MEMORY_GRAPH_EXPANSION_DEPTH=2

# Optional subconscious LLM
MEMORY_LLM_ENABLED=false
MEMORY_LLM_PROVIDER=openai_compatible
MEMORY_LLM_ENDPOINT=https://api.openai.com/v1/chat/completions
MEMORY_LLM_API_KEY=
MEMORY_LLM_MODEL=gpt-4.1-mini
MEMORY_LLM_TEMPERATURE=0.1
